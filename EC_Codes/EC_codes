#include <stdio.h>
#include <ctype.h>

int main(void) {
    char names[100][50];
    char firstLetters[26][100][50];
    int counts[26] = {0};
    int n, i;

    printf("Enter the number of people: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter name %d: ", i + 1);
        scanf("%49s", names[i]);

        char first = (char)toupper((unsigned char)names[i][0]);

        if (first >= 'A' && first <= 'Z') {
            sprintf(firstLetters[first - 'A'][counts[first - 'A']], "%s", names[i]);
            counts[first - 'A']++;
        }
    }

    printf("\nNames segregated by first letter:\n");
    for (i = 0; i < 26; i++) {
        if (counts[i] > 0) {
            printf("%c: ", 'A' + i);
            for (int j = 0; j < counts[i]; j++) {
                printf("%s ", firstLetters[i][j]);
            }
            printf("\n");
        }
    }

    return 0;
}
